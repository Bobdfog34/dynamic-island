<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0E12"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A22"
        android:padding="16dp"
        android:text="Включённые приложения НЕ блокируются — их уведомления будут приходить как обычно. Остальные показываются только в острове."
        android:textColor="#CCFFFFFF"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="40dp" />

    <ListView
        android:id="@+id/listApps"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#1A1A22"
        android:dividerHeight="1dp"
        android:paddingBottom="24dp" />
</LinearLayout>
